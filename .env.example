# Copy to .env.local and fill in. Never commit real values.
# Neon (docs/14-operations.md §3). Pooled URL for the app, direct for drizzle-kit.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Only for one-off scripts that must target production explicitly.
DATABASE_URL_PROD=
DATABASE_URL_PROD_UNPOOLED=
# Admin session signing key: openssl rand -base64 32
AUTH_SECRET=
# Protects /api/cron/* (Vercel Cron sends it as a Bearer token)
CRON_SECRET=
# Vercel → Settings → Git → Deploy Hooks (optional, for "Rebuild site now")
VERCEL_DEPLOY_HOOK_URL=
