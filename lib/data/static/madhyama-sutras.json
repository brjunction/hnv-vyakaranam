{"1": {"t": "nārāyaṇād udbhūto ’yaṁ varṇa-kramaḥ", "p": "By sounding his ḍamaru drum, Lord Śiva revealed to Pāṇini the varna-krama through the 14 pratyāhāra-sūtras (also called the Śiva-sūtras)."}, "2": {"t": "tatrādau caturdaśa sarveśvarāḥ", "p": "ac"}, "3": {"t": "daśa daśāvatārāḥ", "p": "ak"}, "4": {"t": "teṣāṁ dvau dvāv ekātmakau", "p": "1.1.9 tulyāsya-prayatnaṁ savarṇam"}, "5": {"t": "pūrvo vāmanaḥ", "p": "1.2.27 ū-kālo ’j hrasva-dīrgha-plutaḥ"}, "6": {"t": "paras trivikramaḥ", "p": "1.2.27 ū-kālo ’j hrasva-dīrgha-plutaḥ"}, "7": {"t": "a-ā-varjitāḥ sarveśvarā īśvarāḥ", "p": "ic"}, "8": {"t": "daśāvatārā īśāḥ", "p": "ik"}, "9": {"t": "a-ā-i-ī-u-ū anantāḥ", "p": "aṇ"}, "10": {"t": "i-ī-u-ū catuḥ-sanāḥ", "p": "iṇ"}, "11": {"t": "u-ū-ṛ-ṝ catur-bhujāḥ", "p": "uk"}, "12": {"t": "e-ai-o-au catur-vyūhāḥ", "p": "ec"}, "13": {"t": "aṁ iti viṣṇu-cakram", "p": "anusvāra 1.1.8 mukha-nāsikā-vacano"}, "14": {"t": "a̐ iti viṣṇu-cāpaḥ", "p": "’nunāsikaḥ"}, "15": {"t": "aḥ iti viṣṇu-sargaḥ", "p": "visarga"}, "16": {"t": "kādayo viṣṇu-janāḥ", "p": "hal"}, "17": {"t": "te māntāḥ pañca pañca viṣṇu-vargāḥ", "p": "varga"}, "18": {"t": "ka-ca-ṭa-ta-pā hari-kamalāni", "p": "cay"}, "19": {"t": "kha-cha-ṭha-tha-phā hari-khaḍgāḥ", "p": ""}, "20": {"t": "ga-ja-ḍa-da-bā hari-gadāḥ", "p": "jaś"}, "21": {"t": "gha-jha-ḍha-dha-bhā hari-ghoṣāḥ", "p": "jhaṣ"}, "22": {"t": "ṅa-ña-ṇa-na-mā hari-veṇavaḥ", "p": "ñam"}, "23": {"t": "ta etad-varjitā viṣṇu-dāsāḥ", "p": "jhay"}, "24": {"t": "ya-ra-la-vā hari-mitrāṇi", "p": "yaṇ"}, "25": {"t": "śa-ṣa-sa-hā hari-gotrāṇi", "p": "śal"}, "26": {"t": "śa-ṣa-sāḥ śaurayaḥ", "p": "śar"}, "27": {"t": "viṣṇudāsa-harigotrāṇi vaiṣṇavāḥ", "p": "jhal"}, "28": {"t": "harigadā-harighoṣa-hariveṇu-harimitrāṇi haś ca gopālāḥ", "p": "haś"}, "29": {"t": "yādavā anye", "p": "khar"}, "30": {"t": "śauri-varjitās tu sātvatāḥ", "p": "khay"}, "31": {"t": "vāmano laghuḥ", "p": "1.4.10 hrasvaṁ laghu"}, "32": {"t": "trivikramo guruḥ", "p": "1.4.12 dīrghañ ca"}, "33": {"t": "sat-saṅgāt pūrvo vāmano ’pi guruḥ", "p": "1.4.11 saṁyoge guru"}, "34": {"t": "mithaḥ-saṁlagno viṣṇujanaḥ sat-saṅga-saṁjñaḥ", "p": "1.1.7 halo ’nantarāḥ saṁyogaḥ"}, "35": {"t": "varṇa-svarūpe rāmaḥ", "p": "with vowels ‘t’ is used e.g. a-rāma=at (see 1.1.70 ta-paras tat-kālasya); with consonants ‘kāra’ is used e.g. ka-kāra"}, "36": {"t": "tad-ādi-dvaye dvayam", "p": ""}, "37": {"t": "ādeśo viriñciḥ", "p": ""}, "38": {"t": "āgamo viṣṇuḥ", "p": ""}, "39": {"t": "lopo haraḥ", "p": "1.1.60 adarśanaṁ lopaḥ"}, "40": {"t": "sūtrāṇi ṣaḍ-vidhāni", "p": ""}, "41": {"t": "sarva-prakaraṇa-vyāpī varṇa-mātra-nimittakaḥ vārṇo vikāraḥ sandhiḥ syād viṣayāpekṣakaḥ kvacit", "p": ""}, "42": {"t": "daśāvatāra ekātmake militvā trivikramaḥ", "p": "6.1.101 akaḥ savarṇe dīrghaḥ"}, "43": {"t": "a-dvayam i-dvaye e", "p": "6.1.87 ād guṇaḥ"}, "44": {"t": "u-dvaye o", "p": "6.1.87 ād guṇaḥ"}, "45": {"t": "ṛ-dvaye ar", "p": "1.1.51 ur aṇ ra-paraḥ"}, "47": {"t": "ḷ-dvaye al", "p": "1.1.51 ur aṇ ra-paraḥ"}, "48": {"t": "e-dvaye ai", "p": "6.1.88 vṛddhir eci"}, "49": {"t": "o-dvaye au", "p": "6.1.88 vṛddhir eci"}, "50": {"t": "i-dvayam eva yaḥ sarveśvare", "p": "6.1.77 iko yaṇ aci"}, "51": {"t": "u-dvayaṁ vaḥ", "p": "6.1.77 iko yaṇ aci"}, "52": {"t": "ṛ-dvayaṁ raḥ", "p": "6.1.77 iko yaṇ aci"}, "53": {"t": "ḷ-dvayaṁ laḥ", "p": "6.1.77 iko yaṇ aci"}, "54": {"t": "e ay · ai āy", "p": "6.1.78 eco ’y-av-āy-āvaḥ"}, "55": {"t": "o av · au āv", "p": "6.1.78 eco ’y-av-āy-āvaḥ"}, "56": {"t": "e-obhyām asya haro viṣṇupadānte", "p": "6.1.109 eṅaḥ padāntād ati"}, "57": {"t": "ay-ādīnāṁ ya-vayor vā", "p": "8.3.19 lopaḥ śākalyasya"}, "58": {"t": "teṣāṁ na sandhir nityam", "p": "8.2.1 pūrvatrāsiddham"}, "59": {"t": "o-rāmāntānām anantānāṁ cāvyayānāṁ sarveśvare", "p": "1.1.14 nipāta ekāj anāṅ 1.1.15 ot"}, "60": {"t": "īd-ūd-etāṁ dvi-vacanasya maṇīvādi-varjam", "p": "6.1.125 pluta-pragṛhyā aci nityam 1.1.11 īd-ūd-ed dvi-vacanaṁ pragṛhyam"}, "61": {"t": "viṣṇudāso viṣṇupadānte harighoṣe ca harigadā", "p": "8.4.53 jhalāṁ jaś jhaśi 8.2.39 jhalāṁ jaśo ’nte"}, "62": {"t": "hariveṇau hariveṇur vā", "p": "8.4.45 yaro ’nunāsike ’nunāsiko vā"}, "63": {"t": "yādava-mātre harikamalam", "p": "8.4.55 khari ca"}, "64": {"t": "tataḥ śaś cho vā", "p": "8.4.63 śaś cho ’ṭi"}, "65": {"t": "ho harighoṣaḥ", "p": "8.4.62 jhayo ho ’nyatarasyām"}, "66": {"t": "da-tau para-varṇau la-ca-ṭa-vargeṣu nityam", "p": "8.4.40 s-toḥ ś-cunā ś-cuḥ 8.4.41 ṣ-ṭunā ṣ-ṭuḥ 8.4.60 tor li"}, "67": {"t": "taś ca śe", "p": "8.4.40 s-toḥ ś-cunā ś-cuḥ"}, "68": {"t": "no ’ntaś ca-chayoḥ śa-rāmo, viṣṇucakra-pūrvo viṣṇucāpa-pūrvo vā", "p": "8.3.7 naś chavy apraśān 8.3.8 ubhayatharkṣu"}, "69": {"t": "le la-rāma eva", "p": "8.4.60 tor li"}, "70": {"t": "ja-jha-ña-śa-rāmeṣu ña-rāmaḥ", "p": "8.4.40 s-toḥ ś-cunā ś-cuḥ"}, "71": {"t": "śe cānto vā", "p": "8.3.31 śi tuk"}, "72": {"t": "mo viṣṇucakraṁ viṣṇujane", "p": "8.3.23 mo ’nusvāraḥ"}, "73": {"t": "viṣṇucakrasya hariveṇur viṣṇuvarge, viṣṇupadāntasya tu vā", "p": "8.4.58 anusvārasya yayi para-savarṇaḥ 8.4.59 vā padāntasya"}, "74": {"t": "dviḥ sarveśvara-mātrāc chaḥ", "p": "6.1.73 che ca"}, "75": {"t": "viṣṇupadāntāt trivikramād vā", "p": "6.1.76 padāntād vā"}, "76": {"t": "vāmanāt ṅa-ṇa-nā dviḥ sarveśvare", "p": "8.3.32 ṅamo hrasvād aci ṅamuṇ nityam"}, "77": {"t": "ra-rāmāt, sarveśvare tu harigotraṁ vinā", "p": "8.4.49 śaro ’ci"}, "78": {"t": "viṣṇujanād viṣṇudāsasyādarśanaṁ sa-varge viṣṇudāse", "p": "8.4.65 jharo jhari savarṇe"}, "79": {"t": "ca-chayoḥ śa-rāmaḥ · ṭa-ṭhayoḥ ṣa-rāmaḥ · ta-thayoḥ sa-rāmaḥ", "p": "8.3.34 visarjanīyasya saḥ 8.4.40 s-toḥ ś-cunā ś-cuḥ"}, "80": {"t": "ād a-rāma-gopālayor ur nityam", "p": "6.1.113 ato ror aplutād aplute 6.1.114 haśi ca"}, "81": {"t": "a-dvaya-bho-bhago-aghobhyo lopyaḥ, sarveśvare tu yaś ca, na ca lope sandhiḥ", "p": "6.1.104 nād ici — 8.3.17 bho-bhago-agho-apūrvasya yo ’śi — 8.3.18 v-yor laghu-prayatnataraḥ śākaṭāyanasya — 8.3.20 oto gārgyasya — 8.3.22 hali sarveṣām"}, "82": {"t": "eṣa-sa-paro viṣṇujane", "p": "6.1.132 etat-tadoḥ su-lopo ’kor anañ-samāse hali"}, "83": {"t": "ra īśvarāt sarveśvara-gopālayoḥ", "p": "8.2.66 sa-sajuṣo ruḥ"}, "84": {"t": "anīśvarād api ra-rāma-jaḥ", "p": "8.2.66 sa-sajuṣo ruḥ"}, "85": {"t": "ahno viṣṇusargasya ro rātri-rūpa-rathantarād anyeṣu", "p": "8.2.68 (vārttika) ahno ru-vidhau rūpa-rātri-rathantareṣūpasaṁkhyānaṁ kartavyam — 8.2.69 ro ’supi"}, "86": {"t": "ro re lopyaḥ, pūrvaś ca trivikramaḥ", "p": "8.3.14 ro ri — 6.3.111 ḍh-ra-lope pūrvasya dīrgho ’ṇaḥ"}, "87": {"t": "adhātu-viṣṇubhaktikam arthavan nāma", "p": "1.2.45 arthavad adhātur apratyayaḥ prātipadikam"}, "88": {"t": "prakṛtiḥ pūrvā", "p": "1.4.13 yasmāt pratyaya-vidhis tad-ādi pratyaye ’ṅgam"}, "89": {"t": "pratyayaḥ paraḥ", "p": "3.1.1 pratyayaḥ — 3.1.2 paraś ca"}, "90": {"t": "tatra nāmnaḥ su au jas, am au śas, ṭā bhyām bhis, ṅe bhyām bhyas, ṅasi bhyām bhyas, ṅas os ām, ṅi os sup", "p": "4.1.1 ṅy-āp-prātipadikāt 4.1.2 sv-au-jas-am-auṭ-chaṣ-ṭā-bhyāṁ-bhis-ṅe-bhyāṁ-bhyas-ṅasi-bhyāṁ-bhyas-ṅas-os-ām-ṅy-os-sup"}, "91": {"t": "tatra ja-ṭa-śa-ṅa-pā itaḥ, uś ca soḥ, ṅaser iś ca", "p": ""}, "92": {"t": "viṣṇubhakti-siddhaṁ viṣṇu-padam", "p": "1.4.14 sup-tiṅ-antaṁ padam"}, "93": {"t": "sa-ra-rāmayor viṣṇusargo viṣṇupadānte", "p": "8.3.15 khar-avasānayor visarjanīyaḥ"}, "94": {"t": "daśāvatārād am-śasor a-rāma-haraḥ", "p": "6.1.107 ami pūrvaḥ"}, "95": {"t": "daśāvatārasya trivikramaḥ śasi, tasmāt so naḥ puṁsi", "p": "6.1.102 prathamayoḥ pūrva-savarṇaḥ 6.1.103 tasmāc chaso naḥ puṁsi"}, "96": {"t": "a-rāmāntaḥ kṛṣṇa-saṁjñaḥ", "p": ""}, "97": {"t": "kṛṣṇāt ṭā inaḥ", "p": "7.1.12 ṭā-ṅasi-ṅasām ināt-syāḥ"}, "98": {"t": "kṛṣṇasya trivikramo gopāle", "p": "7.3.102 supi ca"}, "99": {"t": "kṛṣṇād bhisa ais", "p": "7.1.9 ato bhisa ais"}, "100": {"t": "kṛṣṇāt ṅer yaḥ", "p": "7.1.13 ṅer yaḥ"}, "101": {"t": "kṛṣṇasya e vaiṣṇave bahutve", "p": "7.3.103 bahu-vacane jhaly et"}, "102": {"t": "kṛṣṇāt ṅaser āt", "p": "7.1.12 ṭā-ṅasi-ṅasām ināt-syāḥ"}, "103": {"t": "kṛṣṇāt ṅasaḥ sya", "p": "7.1.12 ṭā-ṅasi-ṅasām ināt-syāḥ"}, "104": {"t": "kṛṣṇasya e osi", "p": "7.3.104 osi ca"}, "105": {"t": "vāmana-gopī-rādhābhyo nuḍ āmi", "p": "7.1.54 hrasva-nady-āpo nuṭ"}, "106": {"t": "tatra ṭin-mitau sarvatrāgamau śnamaṁ vinā, ug-anta-kic ca", "p": ""}, "107": {"t": "vāmanasya trivikramo nāmi, nṛ-śabdasya tu vā, na tisṛ-catasroḥ", "p": "6.4.3 nāmi — 6.4.4 na tisṛ-catasṛ — 6.4.6 nṛ ca"}, "108": {"t": "īśvara-harimitra-ka-ṅebhyaḥ pratyaya-viriñci-sasya ṣo, num-viṣṇusarga-vyavadhāne ’pi, na tu viṣṇupadādy-anta-sātīnām", "p": "8.3.55 apadāntasya mūrdhanyaḥ — 8.3.57 iṇ-koḥ — 8.3.58 num-visarjanīya-śar-vyavāye ’pi — 8.3.59 ādeśa-pratyayayoḥ — 8.3.111 sāt-padādyoḥ"}, "109": {"t": "sambodhane sur buddha-saṁjñaḥ", "p": "2.3.49 eka-vacanaṁ sambuddhiḥ"}, "110": {"t": "e-o-vāmanebhyo buddhasyādarśanam", "p": "6.1.69 eṅ-hrasvāt sambuddheḥ"}, "111": {"t": "ra-ṣa-ṛ-dvayebhyo nasya ṇaḥ, sarveśvara-ha-ya-va-ka-varga-pa-varga-vyavadhāne ’pi, samāna-viṣṇupade, na tu viṣṇupadāntasya", "p": "8.4.1 ra-ṣābhyāṁ no ṇaḥ samāna-pade — 8.4.2 aṭ-ku-pv-āṅ-num-vyavāye ’pi — 8.4.37 padāntasya — 8.4.38 pada-vyavāye ’pi"}, "112": {"t": "śas-ādayo yadu-saṁjñāḥ", "p": ""}, "113": {"t": "atra pāda danta māsa yūṣa ity eteṣāṁ pad dat mās yūṣan ity ete viriñcayo yaduṣu vā", "p": "6.1.63 pad-dan-no-mās-hṛn-niś-asan-yūṣan-doṣan-yakañ-chakann-udann-āsañ-chas-prabhṛtiṣu"}, "114": {"t": "ā-rāma-haro yadu-sarveśvare, na tv āpaḥ", "p": "6.4.140 āto dhātoḥ"}, "115": {"t": "i-u-rāmānto hari-saṁjñaḥ", "p": "1.4.7 śeṣo ghy asakhi"}, "116": {"t": "harita au pūrva-savarṇaḥ", "p": "6.1.102 prathamayoḥ pūrva-savarṇaḥ"}, "117": {"t": "i-dvayasya e, u-dvayasya o, ṛ-dvayasya ar, ḷ-dvayasya al govinda-saṁjñaḥ", "p": "1.1.2 ad-eṅ guṇaḥ"}, "118": {"t": "ṅito vṛṣṇi-saṁjñāḥ", "p": ""}, "119": {"t": "harer govindo jasi vṛṣṇiṣu buddhe ca", "p": "7.3.108 hrasvasya guṇaḥ — 7.3.109 jasi ca — 7.3.111 gher ṅ-iti"}, "120": {"t": "haritaṣ ṭā nā, na tu lakṣmyām", "p": "7.3.120 āṅo nā ’striyām"}, "121": {"t": "e-obhyāṁ ṅasi-ṅasor a-rāma-haraḥ", "p": "6.1.110 ṅasi-ṅasoś ca"}, "122": {"t": "harito ṅer auc", "p": "7.3.119 ac ca gheḥ"}, "123": {"t": "antya-sarveśvarādi-varṇāḥ saṁsāra-saṁjñāḥ", "p": "1.1.64 aco ’ntyādi ṭi"}, "124": {"t": "saṁsārasya haraś citi", "p": "6.4.143 ṭeḥ"}, "125": {"t": "tres trayo nāmi svārthe", "p": "7.1.53 tres trayaḥ"}, "126": {"t": "ṣa-nānta-saṅkhyātaḥ kateś ca jas-śasor mahāharaḥ svārthe", "p": "1.1.23 bahu-gaṇa-vatu-ḍati saṁkhyā 7.1.22 ṣaḍbhyo luk"}, "127": {"t": "ṛ-rāma-sakhibhyām uśanas purudaṁśas anehas ity etebhyaś ca sor āc, buddhaṁ vinā", "p": "7.1.93 anaṅ sau 7.1.94 ṛd-uśanas-purudaṁśo ’nehasāṁ ca"}, "128": {"t": "a-dvayasya ā, i-dvayasya ai, u-dvayasya au, ṛ-dvayasya ār, ḷ-dvayasya āl vṛṣṇīndra-saṁjñaḥ, e-o-sthāne ai au ca", "p": "1.1.1 vṛddhir ād-aic"}, "129": {"t": "sv-ādayaḥ pañca pāṇḍavāḥ", "p": ""}, "130": {"t": "sakhyur vṛṣṇīndraḥ su-varjaṁ pāṇḍaveṣu", "p": "7.1.92 sakhyur asambuddhau"}, "131": {"t": "na sakhir hari-saṁjñaṣ ṭādau, patis tv asamāse", "p": "1.4.7 śeṣo ghy asakhi 1.4.8 patiḥ samāsa eva"}, "132": {"t": "khya-tyābhyāṁ ṅasi-ṅasor us", "p": "6.1.112 khya-tyāt parasya"}, "133": {"t": "sakhi-patibhyāṁ ṅer au", "p": "7.3.118 aut"}, "134": {"t": "dhātor īd-ūtor iy-uvau sarveśvare bahulam", "p": "6.4.77 aci śnu-dhātu-bhruvāṁ y-vor iyaṅ-uvaṅau"}, "135": {"t": "nī-rādhābhyāṁ ṅer ām", "p": "7.3.116 ṅer ām nady-ām-nībhyaḥ"}, "136": {"t": "ṛ-rāmasya govindaḥ pāṇḍaveṣu ṅau ca", "p": "7.3.110 ṛto ṅi-sarvanāma-sthānayoḥ"}, "137": {"t": "ṛ-rāmato ṅasi-ṅasor asya uc", "p": "6.1.111 ṛta ut"}, "138": {"t": "rādhā-viṣṇujanābhyām īpaś ca trivikramāt sor haraḥ", "p": "6.1.68 hal-ṅy-ābbhyo dīrghāt su-ti-sy-apṛktaṁ hal"}, "139": {"t": "svasṛ-tṛl-tṛn-pratyayāntānāṁ vṛṣṇīndraḥ su-varjaṁ pāṇḍaveṣu", "p": "6.4.11 ap-tṛn-tṛc-svasṛ-naptṛ-neṣṭṛ-tvaṣṭṛ-kṣatṛ-hotṛ-potṛ-praśāstṝṇām"}, "140": {"t": "rāya ā sa-bhoḥ", "p": "7.2.85 rāyo hali"}, "141": {"t": "o au pāṇḍaveṣu", "p": "7.1.90 goto ṇit"}, "142": {"t": "o ā am-śasor, na ca so naḥ", "p": "6.1.93 auto ’m-śasoḥ"}, "143": {"t": "tatrāb-anta-lakṣmī rādhā-saṁjñā", "p": ""}, "144": {"t": "rādhā-brahmabhyām au ī", "p": "7.1.18 auṅa āpaḥ 7.1.19 napuṁsakāc ca"}, "145": {"t": "rādhāyā e ṭausor buddhe ca", "p": "7.3.105 āṅi cāpaḥ 7.3.106 sambuddhau ca"}, "146": {"t": "rādhāto yāp vṛṣṇiṣu", "p": "7.3.113 yāḍ āpaḥ"}, "147": {"t": "ambādīnāṁ gopyāś ca vāmano buddhe", "p": "7.3.107 ambārtha-nadyor hrasvaḥ"}, "148": {"t": "jarāyā jaras vā sarveśvare", "p": "7.2.101 jarāyā jaras anyatarasyām"}, "149": {"t": "atra niśā-nāsikayor niś-nasāv ādeśau yaduṣu vā vācyau", "p": "6.1.63 pad-dan-no-mās-hṛn-niś-asan-yūṣan-doṣan-yakañ-chakann-udann-āsañ-chas-prabhṛtiṣu"}, "150": {"t": "harita āp vā vṛṣṇiṣu lakṣmyāṁ, nityaṁ gopyāḥ", "p": "1.4.6 ṅ-iti hrasvaś ca 7.3.112 āṇ nadyāḥ"}, "151": {"t": "lakṣmī-sthayos tri-caturos tisṛ-catasṛ viṣṇubhaktau", "p": "7.2.99 tri-caturoḥ striyāṁ tisṛ-catasṛ"}, "152": {"t": "tisṛ-catasro raḥ sarveśvare", "p": "7.2.100 aci ra ṛtaḥ"}, "153": {"t": "ī-ū-lakṣmīr gopī-saṁjñā", "p": "1.4.3 y-ū stry-ākhyau nadī"}, "154": {"t": "avī-tantrī-tarī-lakṣmī-hrī-dhī-śrīṇām uṇādinā śabdānāṁ tu bhavaty eṣāṁ su-lopo na kadācana", "p": "These words don’t end in [ṅ]ī, and thus s[u] is not deleted by: 6.1.68 hal-ṅy-ābbhyo dīrghāt su-ti-sy-apṛktaṁ hal"}, "155": {"t": "strī-bhruvor iy-uvau sarveśvare, striyā am-śasor vā", "p": "6.4.77 aci śnu-dhātu-bhruvāṁ y-vor iyaṅ-uvaṅau 6.4.79 striyāḥ 6.4.80 vām-śasoḥ"}, "156": {"t": "ney-uv-sthānaṁ gopī, striyaṁ vinā, vṛṣṇiṣv āmi ca vā", "p": "1.4.4 neyaṅ-uvaṅ-sthānāv astrī 1.4.5 vāmi"}, "157": {"t": "brahma-kṛṣṇāt sor am", "p": "7.1.24 ato ’m"}, "158": {"t": "brahmato jas-śasoḥ śiḥ", "p": "7.1.20 jaś-śasoḥ śiḥ"}, "159": {"t": "sarveśvara-vaiṣṇavāntayor nuṁ śau", "p": "7.1.72 napuṁsakasya jhal-acaḥ"}, "160": {"t": "antya-sarveśvarāt paraṁ mitaḥ sthānam", "p": "1.1.47 m-id aco ’ntyāt paraḥ"}, "161": {"t": "antyāt pūrva-varṇaḥ uddhava-saṁjñaḥ", "p": "1.1.65 alo ’ntyāt pūrva upadhā"}, "162": {"t": "abrahma-pāṇḍavāḥ śiś ca kṛṣṇa-sthāna-saṁjñāḥ", "p": "1.1.42 śi sarvanāma-sthānam 1.1.43 suḍ anapuṁsakasya"}, "163": {"t": "nānta-dhātu-varjita-sānta-sat-saṅga-mahad-apām uddhavasya trivikramaḥ kṛṣṇasthāne, buddhaṁ vinā", "p": "6.4.8 sarvanāma-sthāne cāsambuddhau 6.4.10 sānta-mahataḥ saṁyogasya 6.4.11 ap-tṛn-tṛc-svasṛ-naptṛ-neṣṭṛ-tvaṣṭṛ-kṣatṛ-hotṛ-potṛ-praśāstṝṇām"}, "164": {"t": "hṛdayasya hṛd yaduṣu vā, śīrṣasya śīrṣan vety eke", "p": "6.1.60 śīrṣaṁś chandasi — 6.1.63 pad-dan-no-mās-hṛn-niś-asan-yūṣan-doṣan-yakañ-chakann-udann-āsañ-chas-prabhṛtiṣu"}, "165": {"t": "aviṣṇupadāntasya nasya masya ca viṣṇucakraṁ vaiṣṇave", "p": "8.3.24 naś cāpadāntasya jhali"}, "166": {"t": "brahmataḥ sv-amor mahāharaḥ", "p": "7.1.23 sv-amor napuṁsakāt"}, "167": {"t": "brahmeśāntān nuk sarveśvare, na tv āmi", "p": "7.1.73 iko ’ci vibhaktau"}, "168": {"t": "dadhi-asthi-sakthi-akṣi-śabdānām i-rāmasya an ṭādi-sarveśvare", "p": "7.1.75 asthi-dadhi-sakthy-akṣṇām anaṅ udāttaḥ"}, "169": {"t": "akṛṣṇasthāna-sarveśvaro bhagavat-saṁjñaḥ, taddhite yaś ca", "p": "1.4.18 y-aci bham"}, "170": {"t": "va-ma-sat-saṅga-hīnasyāno ’-rāma-haro bhagavati, na tu ye, ī-ṅyos tu vā", "p": "6.4.134 al-lopo ’naḥ 6.4.136 vibhāṣā ṅi-śyoḥ 6.4.137 na saṁyogād va-m-antāt"}, "171": {"t": "brahmaṇo govindo vā buddhe", "p": ""}, "172": {"t": "brahmānta-trivikramasya vāmanaḥ", "p": "1.2.47 hrasvo napuṁsake prātipadikasya"}, "173": {"t": "e-ai-sthāne i-rāmaḥ, o-au-sthāne u-rāmo vāmanaḥ syāt", "p": "1.1.48 eca ig ghrasvādeśe"}, "174": {"t": "acaś caturbhujānubandhānāṁ ca nuṁ kṛṣṇasthāne", "p": "7.1.70 ugid-acāṁ sarvanāma-sthāne ’dhātoḥ"}, "175": {"t": "ta-vargasya ca-vargaś ca-varga-yoge", "p": "8.4.40 s-toḥ ś-cunā ś-cuḥ"}, "176": {"t": "sat-saṅgāntasya haro viṣṇupadānte", "p": "8.2.23 saṁyogāntasya lopaḥ"}, "177": {"t": "ca-vargasya ka-vargo viṣṇupadānte, vaiṣṇave tv asa-varge", "p": "8.2.30 coḥ kuḥ"}, "178": {"t": "aco ’-rāma-haro bhagavati, pūrvasya trivikramaś ca", "p": "6.1.222 cau 6.4.138 acaḥ"}, "179": {"t": "pūrvasya viṣṇupada-vattvaṁ svādi-taddhitayor aya-sarveśvarādyoḥ", "p": "1.4.17 sv-ādiṣv asarvanāmasthāne 1.4.16 siti ca"}, "180": {"t": "tiryacas tiraścir udaca udīcir bhagavati", "p": "6.4.139 uda īt"}, "181": {"t": "sasya śaś ca-varga-yoge", "p": "8.4.40 s-toḥ ś-cunā ś-cuḥ"}, "182": {"t": "cha-śo rāj-yaj-bhrāj-parivrāj-sṛj-mṛj-bhrasj-vraścāṁ ca ṣo viṣṇupadānte vaiṣṇave ca", "p": "8.2.36 vraśca-bhrasja-sṛja-mṛja-yaja-rāja-bhrāja-ccha-śāṁ ṣaḥ — 8.2.30 (vārttika) parau vrajeḥ ṣaḥ padānte"}, "183": {"t": "s-koḥ sat-saṅgādyor haro viṣṇupadānte vaiṣṇave ca", "p": "8.2.29 s-koḥ saṁyogādyor ante ca"}, "184": {"t": "ṣasya ḍo viṣṇupadānte harighoṣe ca", "p": "8.2.39 jhalāṁ jaśo ’nte 8.4.53 jhalāṁ jaś jhaśi"}, "185": {"t": "viṣṇudāsasya harikamalaṁ vā virāme", "p": "8.4.56 vā ’vasāne"}, "186": {"t": "sraj diś dṛś ṛtvij uṣṇih dadhṛṣ anudaka-pūrva-spṛś tādṛś ity-ādīnāṁ ko viṣṇupadānte", "p": "3.2.58 spṛśo ’nudake kvin 3.2.59 ṛtvig-dadhṛk-srag-dig-uṣṇig-añcu-yuji-kruñcāṁ ca 8.2.62 kvin-pratyayasya kuḥ"}, "187": {"t": "atv-as-antoddhavasya trivikramo buddha-varjita-sau, dhātuṁ vinā", "p": "6.4.14 atv-as-antasya cādhātoḥ"}, "188": {"t": "pāc-chabdasya vāmano bhagavati", "p": "6.4.130 pādaḥ pat"}, "189": {"t": "ja-varja-harigadāder eka-sarveśvarasya dhātor harighoṣāntasyādau harighoṣatvaṁ viṣṇupadānte sa-dhvoś ca", "p": "8.2.37 ekāco baśo bhaṣ jhaṣ-antasya s-dhvoḥ"}, "190": {"t": "nāmāntasya nasya haro viṣṇupadānte buddhaṁ vinā", "p": "8.2.7 na-lopaḥ prātipadikāntasya 8.2.8 na ṅi-sambuddhyoḥ"}, "191": {"t": "śvan yuvan maghavan ity eṣāṁ vasya ur bhagavati īb-varjita-taddhite tu na yuvatīty etad-varjam", "p": "6.4.133 śva-yuva-maghonām a-taddhite"}, "192": {"t": "dhāto ra-va-prāg-id-utos trivikramo ra-vato viṣṇujane, na kura-chura-nāma-dhātūnāṁ, na ca taddhita-ye", "p": "8.2.77 hali ca 8.2.78 upadhāyāṁ ca 8.2.79 na bha-kur-churām"}, "193": {"t": "pathin mathin ṛbhukṣinn ity eṣāṁ nasya haraḥ sau", "p": "7.1.85 pathi-mathy-ṛbhukṣām āt"}, "194": {"t": "pathy-ādīnām i-rāmasyā-rāmaḥ kṛṣṇasthāne, thāt pūrvaṁ nuk ca", "p": "7.1.86 ito ’t sarvanāma-sthāne 7.1.87 tho nthaḥ"}, "195": {"t": "pathy-ādīnāṁ saṁsāra-haro bhagavati", "p": "7.1.88 bhasya ṭer lopaḥ"}, "196": {"t": "in han pūṣan aryaman ity eṣām uddhavasya trivikramaḥ su-śyor eva", "p": "6.4.12 in-han-pūṣāryamṇāṁ śau 6.4.13 sau ca"}, "197": {"t": "hano hasya gho ṇin-nayoḥ", "p": "7.3.54 ho hanter ñ-ṇ-in-neṣu"}, "198": {"t": "ra-ṣa-nānta-saṅkhyābhyo nuḍ āmi svārthe", "p": "1.1.24 ṣ-ṇāntā ṣaṭ 7.1.55 ṣaṭ-caturbhyaś ca"}, "199": {"t": "nāntoddhavasya trivikramo nāmi", "p": "6.4.7 nopadhāyāḥ"}, "200": {"t": "aṣṭana ā viṣṇubhaktiṣu vā", "p": "7.2.84 aṣṭana ā vibhaktau"}, "201": {"t": "tasmāt jas-śasor auś svārthe", "p": "7.1.21 aṣṭābhya auś"}, "202": {"t": "catur-anaḍuhor ām kṛṣṇasthāne, buddhe tv am", "p": "7.1.98 catur-anaḍuhor ām udāttaḥ 7.1.99 am saṁbuddhau"}, "203": {"t": "ra-rāmasya na viṣṇusargaḥ supi", "p": "8.3.16 roḥ supi"}, "204": {"t": "nityaṁ hariveṇu-vidhiḥ pratyaya-hariveṇau", "p": "8.4.45 (vārttika) yaro ’nunāsike pratyaye bhāṣāyāṁ nitya-vacanaṁ kartavyam"}, "205": {"t": "ṣāt parasya ṭa-varga-yuktasya ca ta-vargasya ṭa-vargaḥ, na tu viṣṇupadāntāṭ ṭa-vargād anām-navati-nagarīṇām", "p": "8.4.41 ṣ-ṭunā ṣ-ṭuḥ 8.4.42 na padāntāṭ ṭor anām 8.4.42 (vārttika) anām-navati-nagarīṇām iti vaktavyam"}, "206": {"t": "sajuṣ āśiṣ ity anayor is-us-anta-dhātoś ca ro viṣṇupadānte, tasya viṣṇusargaś ca supi", "p": "8.2.66 sa-sajuṣo ruḥ 6.4.34 (vārttika) kvau ca śāsa itvaṁ bhavatīti vaktavyam"}, "207": {"t": "ir-ur-anta-dhātor uddhavasya trivikramo viṣṇupadānte", "p": "8.2.76 r-vor upadhāyā dīrgha ikaḥ 6.4.34 (vārttika) kvau ca śāsa itvaṁ bhavatīti vaktavyam"}, "208": {"t": "dhvaṁsu-sraṁsu-vasv-anaḍuhāṁ do viṣṇupadānte", "p": "8.2.72 vasu-sraṁsu-dhvaṁsv-anaḍuhāṁ daḥ"}, "209": {"t": "vasor vasya ur bhagavati", "p": "6.4.131 vasoḥ saṁprasāraṇam"}, "210": {"t": "puṁsaḥ pumasuḥ kṛṣṇasthāne", "p": "7.1.89 puṁso ’suṅ"}, "211": {"t": "hasya ḍhaḥ, naho dhaḥ, dādes tu dhātor ghaḥ, druha-muha-naśa-snuha-snihāṁ vā viṣṇupadānte vaiṣṇave ca", "p": "8.2.31 ho ḍhaḥ 8.2.32 dāder dhātor ghaḥ 8.2.33 vā druha-muha-ṣṇuha-ṣṇihām 8.2.34 naho dhaḥ"}, "212": {"t": "apo do bhe", "p": "7.4.48 apo bhi"}, "213": {"t": "diva au sau", "p": "7.1.84 diva aut"}, "214": {"t": "diva ur viṣṇupadānte", "p": "6.1.131 diva ut"}, "215": {"t": "nasya haro vā brahmaṇi buddhe", "p": ""}, "216": {"t": "ahno viṣṇusargo viṣṇupadānte, na samāse puṁsīti vācyam", "p": "8.2.68 ahan"}, "217": {"t": "tatra kṛṣṇādi-śabdāḥ saṁjñā-viśeṣādau niyata-puruṣottamādayaḥ", "p": ""}, "218": {"t": "saṅkhyādi-śabdās tu vācya-liṅgāḥ", "p": ""}, "219": {"t": "samānādhikaraṇa-viśeṣaṇa-rūpā viśeṣya-liṅga-viṣṇubhakti-vacanāni bhajante", "p": ""}, "220": {"t": "jāti-guṇa-kriyā-dvārā yasya viśeṣaḥ kathyate tad viśeṣyaḥ, yena tasya viśeṣaḥ kathyate tad viśeṣaṇam", "p": ""}, "221": {"t": "kecic chabdā viśeṣaṇatve ’pi sva-liṅgaṁ na tyajanti", "p": ""}, "222": {"t": "kvacid bahūnāṁ viśeṣaṇatve ’py ekatvam", "p": ""}, "223": {"t": "viṁśaty-ādyāḥ sadaikatve anāvṛttau", "p": ""}, "224": {"t": "sarvādīni kṛṣṇa-nāmāni", "p": "1.1.27 sarvādīni sarvanāmāni"}, "225": {"t": "kṛṣṇanāma-kṛṣṇato jasaḥ śīḥ", "p": "7.1.17 jasaḥ śī"}, "226": {"t": "kṛṣṇanāma-kṛṣṇato ṅeḥ smai", "p": "7.1.14 sarvanāmnaḥ smai"}, "227": {"t": "kṛṣṇanāma-kṛṣṇato ṅaseḥ smāt", "p": "7.1.15 ṅasi-ṅyoḥ smāt-sminau"}, "228": {"t": "kṛṣṇanāma-kṛṣṇa-rādhābhyāṁ suḍ āmi", "p": "7.1.52 āmi sarvanāmnaḥ suṭ"}, "229": {"t": "kṛṣṇanāma-kṛṣṇato ṅeḥ smin", "p": "7.1.15 ṅasi-ṅyoḥ smāt-sminau"}, "230": {"t": "sarvādiḥ kṛṣṇanāmākhyo gauṇa-saṁjñe vinā bhavet", "p": "1.1.29 na bahuvrīhau 1.1.29 (vārttika) saṁjñopasarjanī-bhūtās tu na sarvādayaḥ"}, "231": {"t": "pūrvādi ca vyavasthāyāṁ saptakaṁ kṛṣṇanāmakam", "p": "1.1.34 pūrva-parāvara-dakṣiṇottarāparādharāṇi vyavasthāyām asaṁjñāyām"}, "232": {"t": "samo ’tulye kṛṣṇanāma", "p": ""}, "233": {"t": "svam ajñāti-dhanāhvaye", "p": "1.1.35 svam ajñāti-dhanākhyāyām"}, "234": {"t": "antaro bāhya-paridhānīyayor, na tv asau puri", "p": "1.1.36 antaraṁ bahir-yogopasaṁvyānayoḥ 1.1.36 (vārttika) apurīti ca vaktavyam"}, "235": {"t": "pūrvādīni nava kṛṣṇanāmāni jasi vā", "p": ""}, "236": {"t": "pūrvādibhyo navabhyaḥ smāt-sminau vā", "p": "7.1.16 pūrvādibhyo navabhyo vā"}, "237": {"t": "prathama-carama-tayāyālpārdha-katipaya-nemāḥ kṛṣṇanāmāni jasi vā", "p": "1.1.33 prathama-carama-tayālpārdha-katipaya-nemāś ca"}, "238": {"t": "tad-ādi-saptānāṁ saṁsārasyā-rāmaḥ sv-ādau, dasya ca maḥ, tad-ādes taḥ saḥ sau", "p": "7.2.102 tyad-ādīnām aḥ 7.2.106 ta-doḥ saḥ sāv anantyayoḥ 7.2.109 daś ca"}, "239": {"t": "idamo ’yaṁ sau, iyaṁ tu lakṣmyāṁ, sākasya tv ayakam-iyakamau", "p": "7.2.108 idamo maḥ 7.2.110 yaḥ sau 7.2.111 ido ’y puṁsi"}, "240": {"t": "idamo ’ka-rāmasya anaṣ ṭausoḥ", "p": "7.2.112 an āpy akaḥ"}, "241": {"t": "vaiṣṇave tv aś", "p": "7.2.113 hali lopaḥ"}, "242": {"t": "idam-adobhyām aka-rāmābhyāṁ nais", "p": "7.1.11 nedam-adasor akoḥ"}, "243": {"t": "etad-idamor enaḥ kathitānukathane dvitīyā-ṭaussu", "p": "2.4.34 dvitīyā-ṭaussv enaḥ"}, "244": {"t": "adaso dasya saḥ sau, sor auc", "p": "7.2.107 adasa au su-lopaś ca"}, "245": {"t": "ado-māt parasya sarveśvarasya u ū yatheṣṭa-siddhi", "p": "8.2.80 adaso ’ser dād u do maḥ"}, "246": {"t": "adasa eta ī bahutve, na tu kāt", "p": "8.2.81 eta īd bahu-vacane"}, "247": {"t": "na dver maḥ", "p": ""}, "248": {"t": "yuṣmad-asmados tvam-aham-ādayaḥ sv-ādinā saha", "p": "3.4.53 dvitīyāyāṁ ca — 7.1.27 yuṣmad-asmadbhyāṁ ṅaso ’ś — 7.1.28 ṅe prathamayor am — 7.1.29 śaso naḥ — 7.1.30 bhyaso bhyam — 7.1.31 pañcamyā at — 7.1.32 eka-vacanasya ca — 7.1.33 sāma ākam — 7.2.86 yuṣmad-asmador anādeśe — 7.2.88 prathamāyāś ca dvi-vacane bhāṣāyām — 7.2.89 yo ’ci — 7.2.90 śeṣe lopaḥ — 7.2.91 ma-paryantasya — 7.2.92 yuvāvau dvi-vacane — 7.2.93 yūya-vayau jasi — 7.2.94 tvāhau sau — 7.2.95 tubhya-mahyau ṅayi — 7.2.96 tava-mamau ṅasi — 7.2.97 tva-māv eka-vacane"}, "249": {"t": "viṣṇupadād vā, anvādeśe tu nityam", "p": "8.1.17 padāt 8.1.26 (vārttika) yuṣmad-asmador vibhāṣā ananvādeśa iti vaktavyam"}, "250": {"t": "yuṣmān yuṣmabhyaṁ yuṣmākam ity eṣāṁ vas, asmān asmabhyam asmākam ity eṣāṁ nas", "p": "8.1.21 bahu-vacanasya vas-nasau"}, "251": {"t": "tubhyaṁ-tavayos te, mahyaṁ-mamayor me", "p": "8.1.22 te-mayāv eka-vacanasya"}, "252": {"t": "tvāṁ māṁ tvā mā", "p": "8.1.23 tvā-mau dvitīyāyāḥ"}, "253": {"t": "yuṣmad-asmad-viṣṇupadayor vāṁ-nau dvitīyā-caturthī-ṣaṣṭhī-dvitve, na tu samāse", "p": "8.1.20 yuṣmad-asmadoḥ ṣaṣṭhī-caturthī-dvitīyā-sthayor vāṁ-nāvau 8.1.18 anudāttaṁ sarvam apādādau"}, "254": {"t": "kimaḥ ko viṣṇubhaktau sākasyāpi", "p": "7.2.103 kimaḥ kaḥ"}, "255": {"t": "kṛṣṇanāma-rādhātaḥ syāp vṛṣṇiṣu, pūrvasya ca vāmanaḥ", "p": "7.3.114 sarvanāmnaḥ syāḍ ḍhrasvaś ca"}, "256": {"t": "anyādibhyas tuk sv-amor brahmaṇi", "p": "7.1.25 adḍ ḍatarādibhyaḥ pañcabhyaḥ"}, "257": {"t": "dvitīyaikatve kathitānukathane idam-etador enad-ādeśo brahmaṇi vācyaḥ", "p": "2.4.34 (vārttika) enad iti napuṁsakaika-vacane vaktavyam"}, "258": {"t": "avyayāt sv-āder mahāharaḥ", "p": "2.4.82 avyayād āp-supaḥ"}, "259": {"t": "svar-ādi cādi vad-ādi-taddhitaḥ ktvā māntaś ca kṛd avyayam", "p": "1.1.37 svar-ādi-nipātam avyayam 1.1.38 taddhitaś cāsarva-vibhaktiḥ 1.1.39 kṛn m-ej-antaḥ 1.1.40 ktvā-tosun-kasunaḥ"}, "260": {"t": "bhū-sanantādyā dhātavaḥ", "p": "1.3.1 bhū-vādayo dhātavaḥ 3.1.32 san-ādy-antā dhātavaḥ"}, "261": {"t": "dhātoḥ", "p": "3.1.91 dhātoḥ"}, "262": {"t": "tatra prāyo vartamāna-kāle tib-ādayo ’ṣṭādaśācyuta-nāmānaḥ", "p": "3.2.123 vartamāne laṭ — 3.4.78 tip-tas-jhi-sip-thas-tha-mib-vas-mas-tātāṁ-jha-thās-āthāṁ-dhvam-iḍ-vahi-mahiṅ — 3.4.79 ṭita ātmanepadānāṁ ṭer e — 3.4.80 thāsaḥ se — 7.1.3 jho ’ntaḥ"}, "263": {"t": "vidhi-sambhāvanādau yād-ādayo vidhi-nāmānaḥ", "p": "3.3.161 vidhi-nimantraṇāmantraṇādhīṣṭa-saṁpraśna-prārthaneṣu liṅ — 3.4.102 liṅas sīyuṭ — 3.4.103 yāsuṭ parasmaipadeṣūdātto ṅic ca — 3.4.105 jhasya ran — 3.4.106 iṭo ’t — 3.4.107 suṭ ti-thoḥ — 3.4.108 jher jus — 6.1.96 usy apadāntāt — 7.2.79 liṅaḥ sa-lopo ’nantyasya"}, "264": {"t": "āśīḥ-preraṇādau tub-ādayo vidhātṛ-nāmānaḥ", "p": "3.3.162 loṭ ca — 3.3.173 āśiṣi liṅ-loṭau — 3.4.85 loṭo laṅ-vat — 3.4.86 er uḥ — 3.4.87 ser hy apic ca — 3.4.89 mer niḥ — 3.4.90 ām etaḥ — 3.4.91 sa-vābhyāṁ vāmau — 3.4.92 āḍ uttamasya pic ca— 3.4.93 eta ai — 3.4.99 nityaṁ ṅitaḥ"}, "265": {"t": "anadyatana-bhūte dib-ādayo bhūteśvara-nāmānaḥ", "p": "3.2.111 anadyatane laṅ — 3.4.100 itaś ca — 3.4.101 tas-thas-tha-mipāṁ tāṁ-taṁ-tāmaḥ"}, "266": {"t": "bhūte dib-ādayo bhūteśa-nāmānaḥ", "p": "3.2.110 luṅ"}, "267": {"t": "parokṣa-bhūte ṇal-ādayo ’dhokṣaja-nāmānaḥ", "p": "3.2.115 parokṣe liṭ 3.4.81 liṭas ta-jhayor eśir ec 3.4.82 parasmaipadānāṁ ṇal-atus-us-thal-athus-a-ṇal-va-māḥ"}, "268": {"t": "āśiṣi yāt yāstām ity-ādayaḥ kāma-pāla-nāmānaḥ", "p": "3.3.173 āśiṣi liṅ-loṭau — 3.4.102 liṅas sīyuṭ — 3.4.103 yāsuṭ parasmaipadeṣūdātto ṅic ca — 3.4.105 jhasya ran — 3.4.106 iṭo ’t — 3.4.107 suṭ ti-thoḥ — 3.4.108 jher jus — 6.1.96 usy apadāntāt — 7.2.79 liṅaḥ sa-lopo ’nantyasya"}, "269": {"t": "arhārthe ’nadyatana-bhaviṣyati ca tādayo bāla-kalki-nāmānaḥ", "p": "2.4.85 luṭaḥ prathamasya ḍā-rau-rasaḥ — 3.1.33 sya-tāsī lṛ-luṭoḥ — 3.3.15 anadyatane luṭ — 7.4.50 tās-astyor lopaḥ — 7.4.51 ri ca — 7.4.52 ha eti"}, "270": {"t": "bhaviṣyat-kāle syaty-ādayaḥ kalki-nāmānaḥ", "p": "3.3.13 lṛt śeṣe ca 3.3.33 prathane vāv aśabde"}, "271": {"t": "sākāṅkṣaṁ yatra kriyātikramo nirdiśyate, tatra kārya-kāraṇayoḥ syad-ādikā ajita-nāmāno bhūte bhaviṣyati ca", "p": "3.3.139 liṅ-nimitte lṛṅ kriyātipattau"}, "272": {"t": "pit pṛthuḥ", "p": ""}, "273": {"t": "ṇin nṛsiṁhaḥ", "p": ""}, "274": {"t": "kit kapilaḥ", "p": ""}, "275": {"t": "ṅin nirguṇaḥ", "p": ""}, "276": {"t": "kic ca ṅic ca kaṁsāriḥ", "p": ""}, "277": {"t": "śit śivaḥ", "p": ""}, "278": {"t": "tib-ādi-nava-navānāṁ pūrva-pūrvāṇi para-pada-saṁjñāni", "p": "1.4.99 laḥ parasmaipadam"}, "279": {"t": "uttarottarāṇy ātma-pada-saṁjñakāni", "p": "1.4.100 taṅ-ānāv ātmanepadam"}, "280": {"t": "navakeṣu trīṇi trīṇi prathama-madhyamottama-puruṣa-saṁjñakāni", "p": "1.4.101 tiṅas trīṇi trīṇi prathama-madhyamottamāḥ"}, "281": {"t": "acyutādayaḥ pañca śivaś ca kṛṣṇa-dhātukāḥ", "p": "3.4.113 tiṅ-śit sārvadhātukam"}, "282": {"t": "anye pratyayā rāma-dhātukāḥ", "p": "3.4.114 ārdhadhātukaṁ śeṣaḥ — 3.4.115 liṭ ca — 3.4.116 liṅ āśiṣi"}, "283": {"t": "parapadāni kartari", "p": "1.3.78 śeṣāt kartari parasmaipadam"}, "284": {"t": "ātmapadibhya ātmapadāni ṅitaś ca", "p": "1.3.12 anudātta-ṅ-ita ātmanepadam"}, "285": {"t": "ubhayapadibhya ubhayapadāni ñitaś ca", "p": "1.3.72 svarita-ñitaḥ kartr-abhiprāye kriyā-phale"}, "286": {"t": "ātmapadāny eva karmaṇi", "p": "1.3.13 bhāva-karmaṇoḥ"}, "287": {"t": "ātmapada-prathama-puruṣaika-vacanam eva bhāve", "p": "1.3.13 bhāva-karmaṇoḥ"}, "288": {"t": "śap kṛṣṇa-dhātuke", "p": "3.1.68 kartari śap"}, "289": {"t": "dhātor antasya govindaḥ pratyaye", "p": "7.3.84 sārvadhātukārdhadhātukayoḥ"}, "290": {"t": "apṛthu-kṛṣṇa-dhātuko nirguṇaḥ", "p": "1.2.4 sārvadhātukam ap-it"}, "291": {"t": "a-rāma-hara e-ayor aviṣṇupadānte", "p": "6.1.97 ato guṇe"}, "292": {"t": "a ā va-moḥ", "p": "7.3.101 ato dīrgho yañi"}, "293": {"t": "yak kṛṣṇa-dhātuke bhāva-karmaṇoḥ", "p": "3.1.67 sārvadhātuke yak"}, "294": {"t": "īśasya na govinda-vṛṣṇīndrau kaṁsāriṣu", "p": "1.1.5 k-ṅ-iti ca"}, "295": {"t": "ata ā is ta-thayoḥ", "p": "7.2.81 āto ṅitaḥ"}, "296": {"t": "ato yā iḥ", "p": "6.1.66 lopo v-yor vali 7.2.80 ato yeyaḥ"}, "297": {"t": "ata iṭ yusi", "p": "7.2.80 ato yeyaḥ"}, "298": {"t": "ato yāma iyam", "p": "7.2.80 ato yeyaḥ"}, "299": {"t": "tu-hyos tātaṅ āśiṣi vā sarvatra", "p": "7.1.35 tu-hyos tātaṅ āśiṣy anyatarasyām"}, "300": {"t": "ato her haraḥ", "p": "6.4.105 ato heḥ"}, "301": {"t": "prādaya upendra-saṁjñā dhātu-yoge, te ca prāk", "p": "1.4.59 upasargāḥ kriyā-yoge 1.4.80 te prāg dhātoḥ"}, "302": {"t": "pūrvokta-nimittatve saty eva ṣatva-ṇatve", "p": "not needed in Pāninian grammar since there is anuvṛtti of the nimittas"}, "303": {"t": "upendrāṇ ṇopadeśasya ṇatvam", "p": "8.4.14 upasargād asamāse ’pi ṇopadeśasya"}, "304": {"t": "hinu-mīnānipāṁ ca", "p": "8.4.15 hinu-mīnā 8.4.16 āni loṭ"}, "305": {"t": "va-mādayas te tv acyutāder eva, nānyasya", "p": ""}, "306": {"t": "dhātoḥ pūrvam at bhūteśvara-bhūteśājiteṣu", "p": "6.4.71 luṅ-laṅ-lṛṅkṣv aḍ udāttaḥ"}, "307": {"t": "sir bhūteśe", "p": "3.1.43 cli luṅi 3.1.44 cleḥ sic"}, "308": {"t": "iṇ-sthā-pibati-dāmodara-bhūbhyaḥ ser mahāharaḥ parapade", "p": "2.4.77 gāti-sthā-ghu-pā-bhūbhyaḥ sicaḥ parasmaipadeṣu"}, "309": {"t": "dāp-daip-dīṅo vinā dā-dhā dāmodara-saṁjñāḥ", "p": "1.1.20 dā-dhā ghv adāp"}, "310": {"t": "bhuvo na govindaḥ si-luki", "p": "7.3.88 bhū-suvos tiṅi"}, "311": {"t": "bhuvo bhūv bhūteśādhokṣaja-sarveśvare", "p": "6.4.88 bhuvo vug luṅ-liṭoḥ"}, "312": {"t": "at-pratiṣedho mā-māsma-yoge", "p": "6.4.74 na māṅ-yoge"}, "313": {"t": "iṇ bhūteśa-te bhāva-karmaṇoḥ", "p": "3.1.66 ciṇ bhāva-karmaṇoḥ"}, "314": {"t": "antasya vṛṣṇīndro nṛsiṁhe", "p": "7.2.115 aco ñ-ṇ-iti"}, "315": {"t": "iṇas to haraḥ", "p": "6.4.104 ciṇo luk"}, "316": {"t": "iṭ rāma-dhātuke", "p": "7.2.35 ārdhadhātukasyeḍ val-ādeḥ"}, "317": {"t": "a-rāmānya-varṇād ante-antām-antānāṁ nasya haraḥ", "p": "7.1.5 ātmanepadeṣv anataḥ"}, "318": {"t": "śīṅo ruṭ ca", "p": "7.1.6 śiṅo ruṭ"}, "319": {"t": "sasya haro dhe", "p": "8.2.25 dhi ca"}, "320": {"t": "īśvara-harimitra-ha-kārebhyaḥ sīdhvaṁ-bhūteśādhokṣajānāṁ dhasya ḍhaḥ", "p": "8.3.78 iṇaḥ ṣīdhvaṁ-luṅ-liṭāṁ dho ’ṅgāt"}, "321": {"t": "iḍ-vyavadhāne tu vā", "p": "8.3.79 vibhāṣeṭaḥ"}, "322": {"t": "dhātor dvir-vacanam adhokṣaja-sann-aṅ-yaṅṣu", "p": "6.1.8 liṭi dhātor anabhyāsasya 6.1.11 caṅi"}, "323": {"t": "sarveśvara-paryantasyādi-bhāgasya anarasya dvir-vacanam", "p": "6.1.1 ekāco dve prathamasya 6.1.8 liṭi dhātor anabhyāsasya"}, "324": {"t": "sarveśvarāditve tu sat-saṅgādi-na-ba-da-ra-varjasyānya-bhāgasya", "p": "6.1.2 aj-āder dvitīyasya 6.1.3 na n-d-rāḥ saṁyogādayaḥ 6.1.3 (vārttika) ba-kārasyāpy ayaṁ pratiṣedho vaktavyaḥ"}, "325": {"t": "san-yaṅos tu tat-sambandhinaḥ sarveśvarasya ca", "p": "6.1.9 san-yaṅoḥ"}, "326": {"t": "pūrvo naraḥ", "p": "6.1.4 pūrvo ’bhyāsaḥ"}, "327": {"t": "paro nārāyaṇaḥ", "p": "6.1.5 ubhe abhyastam"}, "328": {"t": "bhū-narasya bho ’dhokṣaje", "p": "7.4.73 bhavater aḥ"}, "329": {"t": "harikhaḍgasya harikamalaṁ, harighoṣasya harigadā narasya", "p": "8.4.54 abhyāse car ca"}, "330": {"t": "neṭ ya-sarveśvarayoḥ", "p": "7.2.35 ārdhadhātukasyeḍ val-ādeḥ"}, "331": {"t": "kāmapāla-parapadaṁ kapilaḥ", "p": "3.4.104 kid āśiṣi"}, "332": {"t": "dvy-akṣara-dhātor antaḥ pūrvaś ca sarveśvaraḥ sa-viṣṇucāpaḥ, jāgṛ-kathādi-varjam", "p": ""}, "333": {"t": "laghūddhavasya govindaḥ", "p": "7.3.86 pug-anta-laghūpadhasya ca"}, "334": {"t": "asti-sibhyām īḍ dip-sipoḥ", "p": "7.3.96 asti-sico ’pṛkte"}, "335": {"t": "iṭaḥ si-lopa īṭi", "p": "8.2.28 iṭa īṭi"}, "336": {"t": "si-nārāyaṇa-vettibhyo ’na us", "p": "3.4.109 sij-abhyasta-vidibhyaś ca"}, "337": {"t": "asaṁyogād alid-adhokṣajaḥ kapilaḥ", "p": "1.2.5 asaṁyogāl liṭ k-it"}, "338": {"t": "svañjer vā", "p": "1.2.6 (vārttika) śranthi-granthi-dambhi-svañjīnām iti vaktavyam"}, "339": {"t": "a-rāma-harasya nimittam a-rāmaḥ pūrva-vac ca", "p": "1.1.57 acaḥ parasmin pūrva-vidhau 6.1.97 ato guṇe"}, "340": {"t": "ir-anubandhān ṅo vā bhūteśa-parapade", "p": "3.1.57 irito vā"}}